<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/des_sec"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/des_anillo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Progreso de descanso" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="DESCANSO"
            android:textColor="#A3A3AD"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/des_tiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="0 h 00"
            android:textColor="#F4F4EF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/des_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Aviso a las 4 h"
            android:textColor="#A3A3AD"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
